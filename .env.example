# FOR LOCAL WINDOWS PYTHON + AN INSTALLED POSTGRESQL SERVER.
# Copy to .env. FIRST create PostgreSQL role/database (see START_HERE_POSTGRESQL.md).
# Replace password with your own; URL-encode special characters (e.g. @ as %40).
DATABASE_URL=postgresql+psycopg://korena:REPLACE_POSTGRES_PASSWORD@127.0.0.1:5432/pharmaledger
FLASK_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_EMAIL=admin@korena.local
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_YOUR_OWN_ADMIN_PASSWORD_10_CHARS_MIN
PORT=5000
